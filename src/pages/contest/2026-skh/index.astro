<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>2026 숭고한 · Spotboard — SCCC</title>
    <meta name="description" content="2026 숭고한 연합 알고리즘 경진대회 원본 Spotboard 결과 화면" />
    <link rel="icon" href="/assets/images/favicon.ico" />
  </head>
  <body>
    <header>
      <a class="back" href="/contest/">‹ 대회 기록</a>
      <strong>2026 숭고한</strong>
      <nav aria-label="디비전 선택">
        {[1, 2, 3].map(id => <a href={`#div${id}`} data-division={id} aria-current={id === 1 ? 'page' : undefined}>Div. {id}</a>)}
      </nav>
      <a class="direct" href="/contest/2026-skh/div1/" target="_blank" rel="noopener">원본 전체 화면 ↗</a>
    </header>
    <div class="board-wrap" tabindex="0" role="region" aria-label="원본 Spotboard · 좁은 화면에서는 좌우로 스크롤">
      <iframe id="spotboard" src="/contest/2026-skh/div1/" title="2026 숭고한 Division 1 Spotboard" />
    </div>
    <noscript><p>디비전별 결과: <a href="/contest/2026-skh/div1/">Div. 1</a> · <a href="/contest/2026-skh/div2/">Div. 2</a> · <a href="/contest/2026-skh/div3/">Div. 3</a></p></noscript>
    <script>
      const frame = document.querySelector<HTMLIFrameElement>('#spotboard')!;
      const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-division]')];
      const direct = document.querySelector<HTMLAnchorElement>('.direct')!;
      function activate() {
        const id = location.hash.match(/^#div([123])$/)?.[1] || '1';
        const path = `/contest/2026-skh/div${id}/`;
        if (frame.getAttribute('src') !== path) frame.src = path;
        frame.title = `2026 숭고한 Division ${id} Spotboard`;
        direct.href = path;
        links.forEach(link => { if (link.dataset.division === id) link.setAttribute('aria-current', 'page'); else link.removeAttribute('aria-current'); });
      }
      window.addEventListener('hashchange', activate);
      activate();
    </script>
    <style>
      *{box-sizing:border-box}body{margin:0;background:white;color:#1d1d1f;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif}
      header{height:64px;display:flex;align-items:center;gap:24px;padding:0 24px;border-bottom:1px solid #dcdce0;background:#f5f5f7}
      a{color:inherit;text-decoration:none;font-size:14px}.back,.direct{color:#6e6e73}strong{font-size:16px;white-space:nowrap}nav{display:flex;gap:6px}nav a{padding:9px 14px;border-radius:7px}nav a[aria-current]{background:#1d1d1f;color:white}.direct{margin-left:auto}
      .board-wrap{overflow:auto;height:calc(100vh - 64px);height:calc(100dvh - 64px)}iframe{display:block;width:100%;min-width:1280px;height:100%;border:0}a:focus-visible,.board-wrap:focus-visible{outline:3px solid #0071e3;outline-offset:-3px}
      @media(max-width:640px){header{height:104px;padding:12px 16px;gap:12px;flex-wrap:wrap}.back{font-size:12px}strong{font-size:14px}nav{order:3;width:100%;justify-content:center}nav a{padding:7px 18px}.direct{font-size:11px}.board-wrap{height:calc(100vh - 104px);height:calc(100dvh - 104px)}}
    </style>
  </body>
</html>
