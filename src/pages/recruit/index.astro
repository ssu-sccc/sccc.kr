---
import ContentLayout from '../../layouts/ContentLayout.astro';
import { getIndexRows } from '../../lib/content';

const rows = getIndexRows('content/recruit/index.md').slice(1);
---

<ContentLayout title="신입 부원 모집" description="SCCC의 학기별 신입 부원 모집 공고와 지원 기록입니다." section="SCCC" sectionHref="/">
  <p class="archive-lead">SCCC는 알고리즘과 문제해결을 꾸준히 공부하고 싶은 숭실대학교 학생을 기다립니다.</p>
  <div class="recruit-current">
    <div>
      <span>최근 모집</span>
      <h2>2026학년도<br />2학기 신입 부원</h2>
    </div>
    <a class="button button--primary" href="/recruit/2026/2/">모집 공고 보기</a>
  </div>
  <h2 class="archive-title">지난 모집</h2>
  <div class="archive-list archive-list--compact">
    {rows.map((row) => (
      <article class="archive-row">
        <div class="archive-row__label" set:html={row.cells[0]} />
        <div class="archive-row__detail" set:html={row.cells[1]} />
        <div class="archive-row__note" set:html={row.cells[2] || ''} />
      </article>
    ))}
  </div>
</ContentLayout>
