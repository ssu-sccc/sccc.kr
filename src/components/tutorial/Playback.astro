<div class="t-controls">
  <button type="button" data-reset aria-label="처음으로">처음</button>
  <button type="button" data-prev aria-label="이전 단계">이전</button>
  <button type="button" data-play class="t-primary">재생</button>
  <button type="button" data-next aria-label="다음 단계">다음</button>
  <input data-progress type="range" min="0" max="1" value="0" aria-label="시각화 단계" />
  <span data-step class="t-step">0 / 0</span>
</div>
